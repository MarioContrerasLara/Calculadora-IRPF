[Unit]
Description=Calculadora IRPF - Node.js HTTPS Server
After=network.target

[Service]
Type=simple
User=mario
Environment=NVM_DIR=/home/mario/.nvm
Environment=HTTPS_PORT=443
ExecStart=/usr/local/bin/node /home/mario/IRPF/Calculadora-IRPF/server.js
WorkingDirectory=/home/mario/IRPF/Calculadora-IRPF
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
